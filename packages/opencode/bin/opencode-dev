#!/usr/bin/env bun

import { spawn } from "child_process"
import { realpath } from "fs"
import { dirname, join } from "path"
import { homedir } from "os"

// Store the original working directory
const originalCwd = process.cwd()

// Change to the opencode project directory to ensure dependencies are found
const opencodeDir = "/Users/katherinemasseau/os/packages/opencode"
process.chdir(opencodeDir)

// Set environment variable so opencode knows the original working directory
process.env.OPENCODE_ORIGINAL_CWD = originalCwd

// Run the development command
const child = spawn("bun", ["run", "--conditions=browser", "./src/index.ts"], {
  stdio: "inherit",
  env: process.env,
  cwd: opencodeDir
})

child.on("exit", (code) => {
  process.exit(code ?? 0)
})